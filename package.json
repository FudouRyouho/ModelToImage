    "file-saver": "^2.0.5",
    "gif.js": "^0.2.0",
    "gif.js.optimized": "^1.0.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-masonry-css": "^1.0.16",
    "react-redux": "^9.3.1",
    "redux-persist": "^6.0.0",
    "redux-persist-node-storage": "^2.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.5",
